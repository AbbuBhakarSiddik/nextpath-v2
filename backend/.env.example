# NextPath.ai — Backend Environment Configuration Example
# Copy this file to .env and provide your actual API keys & Supabase credentials

PORT=5000
NODE_ENV=development

# Google Gemini API Key (Required for AI Chat, Roadmap, Quiz generation)
# Get a key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# NewsAPI Key (Required for Daily Tech News feed)
# Get a free key at: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# PostgreSQL Database Connection String (Supabase / Prisma ORM)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
